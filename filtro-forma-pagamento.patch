diff --git a/app/Http/Controllers/PassagemController.php b/app/Http/Controllers/PassagemController.php
index ae1c27e..1c60f56 100644
--- a/app/Http/Controllers/PassagemController.php
+++ b/app/Http/Controllers/PassagemController.php
@@ -489,8 +489,10 @@ public function minhasVendas(Request $request)
         $u = auth()->user();
         [$inicio, $fim, $periodo] = \App\Http\Controllers\CaixaController::periodo($request);
 
+        $canal = $request->input('canal'); // dinheiro|pix_manual|pix_auto|debito|credito
         $vendas = Passagem::where('user_id', $u->id)->where('cancelada', false)
             ->whereBetween('created_at', [$inicio, $fim])
+            ->when($canal, fn ($q) => $q->whereHas('pagamentos', fn ($w) => $w->canal($canal)))
             ->with(['passageiros:id,passagem_id', 'embarcacao:id,nome'])
             ->orderByDesc('id')->get();
 
@@ -520,7 +522,7 @@ public function minhasVendas(Request $request)
             ];
         }
 
-        return view('passagens.minhas-vendas', compact('vendas', 'totais', 'acerto', 'inicio', 'fim', 'periodo'));
+        return view('passagens.minhas-vendas', compact('vendas', 'totais', 'acerto', 'inicio', 'fim', 'periodo', 'canal'));
     }
 
     /** Tela de check-in (hub): escaneia o QR do bilhete ou busca pelo numero. */
diff --git a/app/Http/Controllers/RelatorioController.php b/app/Http/Controllers/RelatorioController.php
index 628a299..25146e2 100644
--- a/app/Http/Controllers/RelatorioController.php
+++ b/app/Http/Controllers/RelatorioController.php
@@ -19,7 +19,10 @@ public function meu(Request $request)
         $cadastros = Encomenda::when(! $todos, fn ($q) => $q->where('user_id', $uid))
             ->whereBetween('created_at', [$inicio, $fim])->with('embarcacao')->orderByDesc('id')->get();
 
+        $canal = $request->input('canal'); // dinheiro|pix_manual|pix_auto|debito|credito
+
         $recebimentos = Pagamento::when(! $todos, fn ($q) => $q->where('user_id', $uid))->where('estornado', false)
+            ->when($canal, fn ($q) => $q->canal($canal))
             ->whereBetween('created_at', [$inicio, $fim])->with('encomenda')->orderByDesc('id')->get();
 
         $entregas = Evento::when(! $todos, fn ($q) => $q->where('user_id', $uid))->where('tipo', 'entrega')
@@ -28,7 +31,7 @@ public function meu(Request $request)
         $porMeio = $recebimentos->where('meio', '!=', 'desconto')->groupBy('canal')->map->sum('valor');
         $modo = $request->input('modo') === 'resumido' ? 'resumido' : 'analitico';
 
-        return view('caixa.meu', compact('cadastros', 'recebimentos', 'entregas', 'porMeio', 'inicio', 'fim', 'periodo', 'todos', 'modo'))
+        return view('caixa.meu', compact('cadastros', 'recebimentos', 'entregas', 'porMeio', 'inicio', 'fim', 'periodo', 'todos', 'modo', 'canal'))
             ->with(['meios' => Pagamento::CANAIS]);
     }
 }
diff --git a/app/Models/Pagamento.php b/app/Models/Pagamento.php
index 256f132..1c555be 100644
--- a/app/Models/Pagamento.php
+++ b/app/Models/Pagamento.php
@@ -43,6 +43,17 @@ public function getCanalAttribute(): string
         return (string) $this->meio;
     }
 
+    /** Filtra por canal (forma de pagamento), dividindo o PIX em manual/automático. */
+    public function scopeCanal($q, ?string $canal)
+    {
+        return match ($canal) {
+            'pix_manual' => $q->where('meio', 'pix')->where(fn ($w) => $w->where('pix_auto', false)->orWhereNull('pix_auto')),
+            'pix_auto'   => $q->where('meio', 'pix')->where('pix_auto', true),
+            'dinheiro', 'debito', 'credito' => $q->where('meio', $canal),
+            default      => $q,
+        };
+    }
+
     public function encomenda(): BelongsTo { return $this->belongsTo(Encomenda::class); }
     public function user(): BelongsTo { return $this->belongsTo(User::class); }
 
