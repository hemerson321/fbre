 app/Http/Controllers/PassagemController.php | 13 +++++++++++--
 app/Support/Versao.php                      |  2 +-
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/app/Http/Controllers/PassagemController.php b/app/Http/Controllers/PassagemController.php
index 1c60f56..d289e01 100644
--- a/app/Http/Controllers/PassagemController.php
+++ b/app/Http/Controllers/PassagemController.php
@@ -551,8 +551,17 @@ public function buscarCheckin(Request $request)
     public function comprovante(Passagem $passagem)
     {
         abort_unless($passagem->empresa_id === Tenant::id(), 404);
-        $passagem->load(['passageiros', 'embarcacao', 'operador']);
-        return view('passagens.comprovante', ['p' => $passagem, 'empresa' => Tenant::empresa(), 'modo' => request('modo')]);
+        $passagem->load(['passageiros', 'embarcacao', 'operador', 'camarote']);
+        try {
+            $html = view('passagens.comprovante', ['p' => $passagem, 'empresa' => Tenant::empresa(), 'modo' => request('modo')])->render();
+            return response($html);
+        } catch (\Throwable $e) {
+            report($e);
+            $msg = auth()->user()?->admin
+                ? 'Erro no comprovante: '.class_basename($e).': '.$e->getMessage().' @ '.basename($e->getFile()).':'.$e->getLine()
+                : 'Não foi possível gerar o comprovante. Tente novamente ou chame o suporte.';
+            return response($msg, 500);
+        }
     }
 
     /** Tela de check-in (vinda do QR do comprovante) — valida embarque, só operador logado. */
diff --git a/app/Support/Versao.php b/app/Support/Versao.php
index a70324a..704bbb4 100644
--- a/app/Support/Versao.php
+++ b/app/Support/Versao.php
@@ -8,5 +8,5 @@
  */
 class Versao
 {
-    public const ATUAL = 'v2026.10.26.16';
+    public const ATUAL = 'v2026.10.26.17';
 }
